<?xml version="1.0" encoding="utf-8"?>
<!-- Synthetic sample: not a real server. Contoso Retail is fictional; every host, IP, account and secret is fake. -->
<configuration>
  <system.applicationHost>
    <applicationPools>
      <add name="DefaultAppPool">
        <processModel identityType="ApplicationPoolIdentity" />
      </add>
      <add name="Commerce-Web" managedRuntimeVersion="v4.0" managedPipelineMode="Integrated" startMode="AlwaysRunning" queueLength="5000" autoStart="true">
        <processModel idleTimeout="00:00:00" />
        <recycling logEventOnRecycle="Time, Requests, Schedule, Memory, PrivateMemory">
          <periodicRestart time="00:00:00" privateMemory="3145728">
            <schedule>
              <clear />
              <add value="03:15:00" />
            </schedule>
          </periodicRestart>
        </recycling>
      </add>
      <!-- cpu limit is stored in 1/1000 of a percent: 80000 = 80% -->
      <add name="Commerce-API" managedRuntimeVersion="" startMode="AlwaysRunning" queueLength="3000">
        <processModel maxProcesses="4" idleTimeout="00:00:00" />
        <cpu limit="80000" action="Throttle" resetInterval="00:01:00" />
      </add>
      <add name="Commerce-API-v2" managedRuntimeVersion="" startMode="AlwaysRunning">
        <processModel idleTimeout="00:45:00" idleTimeoutAction="Suspend" />
        <environmentVariables>
          <add name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </add>
      <add name="Legacy-Reports-32bit" enable32BitAppOnWin64="true" managedRuntimeVersion="v2.0" managedPipelineMode="Classic" queueLength="800">
        <processModel pingingEnabled="false" shutdownTimeLimit="00:05:00" />
        <recycling>
          <periodicRestart requests="500000" />
        </recycling>
        <failure rapidFailProtection="false" />
      </add>
      <add name="Intranet-NetworkService" managedRuntimeVersion="v4.0">
        <processModel identityType="NetworkService" />
      </add>
      <add name="Static-Content" managedRuntimeVersion="" autoStart="true">
        <processModel idleTimeout="02:00:00" />
      </add>
      <add name="Orphan-Pool-Unused" autoStart="false" managedRuntimeVersion="v2.0" managedPipelineMode="Classic" />
      <add name="Commerce Admin Tools" managedRuntimeVersion="v4.0">
        <processModel identityType="SpecificUser" userName="CONTOSO\svc-commerce-admin" password="[enc:IISWASOnlyCngProvider:ZGVtby1zeW50aGV0aWM=:enc]" />
      </add>
      <applicationPoolDefaults managedRuntimeVersion="v4.0">
        <processModel identityType="ApplicationPoolIdentity" idleTimeout="00:30:00" />
      </applicationPoolDefaults>
    </applicationPools>
    <listenerAdapters>
      <add name="http" />
      <add name="net.tcp" identity="S-1-5-80-3579033775-2824656752-1522793541-1960352512-462907086" />
    </listenerAdapters>
    <log>
      <centralBinaryLogFile enabled="false" />
      <centralW3CLogFile enabled="true" directory="D:\Logs\IIS\Central" />
    </log>
    <sites>
      <site name="Commerce Storefront" id="2" serverAutoStart="true">
        <application path="/" applicationPool="Commerce-Web" preloadEnabled="true">
          <virtualDirectory path="/" physicalPath="E:\Sites\Commerce\Storefront" />
          <virtualDirectory path="/media" physicalPath="\\fs01.corp.contoso.test\media$" userName="CONTOSO\svc-media" password="[enc:IISCngProvider:ZGVtby1tZWRpYS1zaGFyZQ==:enc]" />
          <virtualDirectory path="/media/images" physicalPath="\\fs01.corp.contoso.test\media$\images" userName="CONTOSO\svc-media" password="[enc:IISCngProvider:ZGVtby1tZWRpYS1zaGFyZQ==:enc]" logonMethod="Network" />
          <virtualDirectory path="/downloads" physicalPath="E:\Downloads\Commerce" />
        </application>
        <application path="/api" applicationPool="Commerce-API">
          <virtualDirectory path="/" physicalPath="E:\Sites\Commerce\Bff" />
        </application>
        <application path="/admin" applicationPool="Commerce Admin Tools">
          <virtualDirectory path="/" physicalPath="E:\Sites\Commerce\Admin" />
        </application>
        <application path="/static" applicationPool="Static-Content">
          <virtualDirectory path="/" physicalPath="E:\Sites\Commerce\Static" />
        </application>
        <bindings>
          <binding protocol="http" bindingInformation="*:80:shop.contoso.test" />
          <binding protocol="https" bindingInformation="*:443:shop.contoso.test" sslFlags="1" />
          <binding protocol="http" bindingInformation="*:8080:" />
        </bindings>
        <limits maxConnections="20000" connectionTimeout="00:03:00" />
        <logFile logFormat="W3C" directory="E:\IISLogs\Commerce" period="Hourly" localTimeRollover="true" logExtFileFlags="Date, Time, ClientIP, UserName, ServerIP, Method, UriStem, UriQuery, HttpStatus, Win32Status, BytesSent, BytesRecv, TimeTaken, ServerPort, UserAgent, Referer, Host, HttpSubStatus">
          <customFields>
            <clear />
            <add logFieldName="X-Forwarded-For" sourceName="X-Forwarded-For" sourceType="RequestHeader" />
            <add logFieldName="X-Correlation-Id" sourceName="X-Correlation-Id" sourceType="RequestHeader" />
          </customFields>
        </logFile>
        <traceFailedRequestsLogging enabled="true" directory="E:\IISLogs\FREB\Commerce" maxLogFiles="200" maxLogFileSizeKB="4096" />
      </site>
      <site name="Commerce API" id="3" serverAutoStart="true">
        <application path="/" applicationPool="Commerce-API">
          <virtualDirectory path="/" physicalPath="E:\Sites\Commerce\Api" />
          <virtualDirectory path="/docs" physicalPath="E:\Sites\Commerce\Api\docs" />
          <virtualDirectory path="/files" physicalPath="\\fs02.corp.contoso.test\apiuploads$" userName="CONTOSO\svc-apiupload" password="[enc:IISCngProvider:ZGVtby1hcGktdXBsb2Fk:enc]" />
        </application>
        <application path="/v1" applicationPool="Commerce-API">
          <virtualDirectory path="/" physicalPath="E:\Sites\Commerce\Api\v1" />
        </application>
        <application path="/v2" applicationPool="Commerce-API-v2">
          <virtualDirectory path="/" physicalPath="E:\Sites\Commerce\Api\v2" />
        </application>
        <application path="/internal" applicationPool="Intranet-NetworkService" enabledProtocols="http,net.tcp">
          <virtualDirectory path="/" physicalPath="E:\Sites\Commerce\Api\internal" />
        </application>
        <bindings>
          <binding protocol="https" bindingInformation="*:443:api.contoso.test" sslFlags="1" />
          <binding protocol="http" bindingInformation="*:8081:" />
          <binding protocol="net.tcp" bindingInformation="808:*" />
        </bindings>
        <logFile>
          <customFields>
            <clear />
            <add logFieldName="X-Forwarded-For" sourceName="X-Forwarded-For" sourceType="RequestHeader" />
            <add logFieldName="X-Request-Id" sourceName="X-Request-Id" sourceType="RequestHeader" />
            <add logFieldName="X-Forwarded-Proto" sourceName="HTTP_X_FORWARDED_PROTO" sourceType="ServerVariable" />
          </customFields>
        </logFile>
        <hsts enabled="true" max-age="31536000" includeSubDomains="true" redirectHttpToHttps="true" />
      </site>
      <site name="Reports Legacy" id="4">
        <application path="/" applicationPool="Legacy-Reports-32bit">
          <virtualDirectory path="/" physicalPath="E:\Sites\Reports\Legacy" />
          <virtualDirectory path="/exports" physicalPath="E:\Exports\Reports" />
          <virtualDirectory path="/templates" physicalPath="\\fs01.corp.contoso.test\reporttemplates$" userName="CONTOSO\svc-reports" password="P@ssw0rd-demo-only" />
          <virtualDirectory path="/legacy-assets" physicalPath="D:\Legacy\Assets" />
        </application>
        <application path="/api" applicationPool="Commerce-Web">
          <virtualDirectory path="/" physicalPath="E:\Sites\Reports\Api" />
        </application>
        <application path="/admin" applicationPool="Legacy-Reports-32bit">
          <virtualDirectory path="/" physicalPath="E:\Sites\Reports\Admin" />
        </application>
        <bindings>
          <binding protocol="http" bindingInformation="*:8088:" />
        </bindings>
        <logFile logFormat="IIS" period="Weekly" />
        <traceFailedRequestsLogging enabled="true" maxLogFiles="500" />
      </site>
      <site name="Partner FTP" id="9">
        <application path="/">
          <virtualDirectory path="/" physicalPath="D:\FTP\Partner" />
          <virtualDirectory path="/inbound" physicalPath="\\fs01.corp.contoso.test\ftp-inbound$" userName="CONTOSO\svc-ftp-files" password="[enc:IISCngProvider:ZGVtby1mdHAtcGFydG5lcg==:enc]" />
          <virtualDirectory path="/outbound" physicalPath="\\fs01.corp.contoso.test\ftp-outbound$" userName="CONTOSO\svc-ftp-files" password="[enc:IISCngProvider:ZGVtby1mdHAtcGFydG5lcg==:enc]" />
        </application>
        <bindings>
          <binding protocol="ftp" bindingInformation="*:21:" />
        </bindings>
        <ftpServer>
          <connections maxConnections="200" controlChannelTimeout="300" dataChannelTimeout="60" />
          <security>
            <ssl serverCertHash="A1B2C3D4E5F60718293A4B5C6D7E8F9012345678" serverCertStoreName="MY" controlChannelPolicy="SslRequire" dataChannelPolicy="SslRequire" ssl128="true" />
            <authentication>
              <anonymousAuthentication enabled="false" />
              <basicAuthentication enabled="true" defaultLogonDomain="CONTOSO" />
            </authentication>
            <commandFiltering>
              <add command="DELE" allowed="false" />
            </commandFiltering>
          </security>
          <userIsolation mode="IsolateRootDirectoryOnly" />
          <messages greetingMessage="Contoso Retail partner exchange. Authorised users only." suppressDefaultBanner="true" />
          <firewallSupport externalIp4Address="203.0.113.21" />
          <logFile directory="D:\Logs\FTP\Partner" />
        </ftpServer>
      </site>
      <site name="Public Downloads FTP" id="10">
        <application path="/">
          <virtualDirectory path="/" physicalPath="E:\FTP\Public" />
          <virtualDirectory path="/releases" physicalPath="E:\FTP\Public\releases" />
          <virtualDirectory path="/archive" physicalPath="\\fs02.corp.contoso.test\archive$" userName="CONTOSO\svc-ftp-archive" password="[enc:IISCngProvider:ZGVtby1mdHAtYXJjaGl2ZQ==:enc]" />
        </application>
        <bindings>
          <binding protocol="ftp" bindingInformation="*:2121:" />
        </bindings>
        <ftpServer>
          <connections maxBandwidth="10485760" maxConnections="500" resetOnMaxConnections="true" />
          <security>
            <ssl controlChannelPolicy="SslAllow" dataChannelPolicy="SslAllow" />
            <authentication>
              <anonymousAuthentication enabled="true" userName="CONTOSO\svc-ftp-anon" password="[enc:IISCngProvider:ZGVtby1mdHAtYW5vbg==:enc]" />
            </authentication>
          </security>
          <directoryBrowse showFlags="StyleUnix, DisplayAvailableBytes, DisplayVirtualDirectories" />
          <logFile directory="D:\Logs\FTP\PublicDownloads" period="Weekly" />
        </ftpServer>
      </site>
      <siteDefaults>
        <logFile logFormat="W3C" directory="D:\Logs\IIS\LogFiles" />
        <traceFailedRequestsLogging directory="D:\Logs\IIS\FailedReqLogFiles" maxLogFiles="100" maxLogFileSizeKB="2048" />
      </siteDefaults>
      <applicationDefaults applicationPool="DefaultAppPool" />
      <virtualDirectoryDefaults allowSubDirConfig="true" />
    </sites>
    <webLimits connectionTimeout="00:02:30" minBytesPerSecond="480" />
  </system.applicationHost>
  <system.webServer>
    <asp>
      <cache diskTemplateCacheDirectory="%SystemDrive%\inetpub\temp\ASP Compiled Templates" />
    </asp>
    <caching enabled="true" enableKernelCache="true" />
    <defaultDocument enabled="true">
      <files>
        <add value="Default.htm" />
        <add value="Default.asp" />
        <add value="index.htm" />
        <add value="index.html" />
        <add value="iisstart.htm" />
        <add value="default.aspx" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <globalModules>
      <add name="HttpLoggingModule" image="%windir%\System32\inetsrv\loghttp.dll" />
      <add name="UriCacheModule" image="%windir%\System32\inetsrv\cachuri.dll" />
      <add name="FileCacheModule" image="%windir%\System32\inetsrv\cachfile.dll" />
      <add name="TokenCacheModule" image="%windir%\System32\inetsrv\cachtokn.dll" />
      <add name="HttpCacheModule" image="%windir%\System32\inetsrv\cachhttp.dll" />
      <add name="DynamicCompressionModule" image="%windir%\System32\inetsrv\compdyn.dll" />
      <add name="StaticCompressionModule" image="%windir%\System32\inetsrv\compstat.dll" />
      <add name="DefaultDocumentModule" image="%windir%\System32\inetsrv\defdoc.dll" />
      <add name="DirectoryListingModule" image="%windir%\System32\inetsrv\dirlist.dll" />
      <add name="ProtocolSupportModule" image="%windir%\System32\inetsrv\protsup.dll" />
      <add name="HttpRedirectionModule" image="%windir%\System32\inetsrv\redirect.dll" />
      <add name="StaticFileModule" image="%windir%\System32\inetsrv\static.dll" />
      <add name="AnonymousAuthenticationModule" image="%windir%\System32\inetsrv\authanon.dll" />
      <add name="CertificateMappingAuthenticationModule" image="%windir%\System32\inetsrv\authcert.dll" />
      <add name="BasicAuthenticationModule" image="%windir%\System32\inetsrv\authbas.dll" />
      <add name="WindowsAuthenticationModule" image="%windir%\System32\inetsrv\authsspi.dll" />
      <add name="DigestAuthenticationModule" image="%windir%\System32\inetsrv\authmd5.dll" />
      <add name="IpRestrictionModule" image="%windir%\System32\inetsrv\iprestr.dll" />
      <add name="DynamicIpRestrictionModule" image="%windir%\System32\inetsrv\diprestr.dll" />
      <add name="RequestFilteringModule" image="%windir%\System32\inetsrv\modrqflt.dll" />
      <add name="CustomErrorModule" image="%windir%\System32\inetsrv\custerr.dll" />
      <add name="FailedRequestsTracingModule" image="%windir%\System32\inetsrv\iisfreb.dll" />
      <add name="ManagedEngine64" image="%windir%\Microsoft.NET\Framework64\v2.0.50727\webengine.dll" preCondition="integratedMode,runtimeVersionv2.0,bitness64" />
      <add name="ManagedEngine" image="%windir%\Microsoft.NET\Framework\v2.0.50727\webengine.dll" preCondition="integratedMode,runtimeVersionv2.0,bitness32" />
      <add name="ManagedEngineV4.0_32bit" image="%windir%\Microsoft.NET\Framework\v4.0.30319\webengine4.dll" preCondition="integratedMode,runtimeVersionv4.0,bitness32" />
      <add name="ManagedEngineV4.0_64bit" image="%windir%\Microsoft.NET\Framework64\v4.0.30319\webengine4.dll" preCondition="integratedMode,runtimeVersionv4.0,bitness64" />
      <add name="AspNetCoreModuleV2" image="%ProgramFiles%\IIS\Asp.Net Core Module\V2\aspnetcorev2.dll" />
      <add name="RewriteModule" image="%SystemRoot%\system32\inetsrv\rewrite.dll" />
      <add name="ApplicationRequestRouting" image="%ProgramFiles%\IIS\Application Request Routing\requestRouter.dll" />
    </globalModules>
    <httpErrors errorMode="DetailedLocalOnly" lockAttributes="allowAbsolutePathsWhenDelegated,defaultPath">
      <error statusCode="401" prefixLanguageFilePath="%SystemDrive%\inetpub\custerr" path="401.htm" />
      <error statusCode="403" prefixLanguageFilePath="%SystemDrive%\inetpub\custerr" path="403.htm" />
      <error statusCode="404" prefixLanguageFilePath="%SystemDrive%\inetpub\custerr" path="404.htm" />
      <error statusCode="500" prefixLanguageFilePath="%SystemDrive%\inetpub\custerr" path="500.htm" />
      <error statusCode="502" prefixLanguageFilePath="%SystemDrive%\inetpub\custerr" path="502.htm" />
    </httpErrors>
    <httpLogging dontLog="false" />
    <httpProtocol>
      <customHeaders>
        <clear />
        <add name="X-Powered-By" value="ASP.NET" />
      </customHeaders>
      <redirectHeaders>
        <clear />
      </redirectHeaders>
    </httpProtocol>
    <httpRedirect enabled="false" />
    <rewrite>
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
        <add name="HTTP_X_ORIGINAL_HOST" />
      </allowedServerVariables>
      <globalRules>
        <rule name="Retire legacy shop host" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^old-shop\.contoso\.test$" />
          </conditions>
          <action type="Redirect" url="https://shop.contoso.test/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="API gateway to commerce-api-farm" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^api-gateway/(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_ORIGINAL_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://commerce-api-farm/{R:1}" />
        </rule>
        <rule name="Proxy archive to legacy-reports-farm" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^archive/(.*)" />
          <action type="Rewrite" url="http://legacy-reports-farm/{R:1}" />
        </rule>
      </globalRules>
    </rewrite>
    <proxy enabled="true" timeout="00:02:00" preserveHostHeader="true" reverseRewriteHostInResponseHeaders="false" httpVersion="Http11" arrResponseHeader="false">
      <cache enabled="true" queryStringHandling="Accept" />
    </proxy>
    <security>
      <access sslFlags="None" />
      <authentication>
        <anonymousAuthentication enabled="true" userName="IUSR" />
        <basicAuthentication enabled="false" />
        <clientCertificateMappingAuthentication enabled="false" />
        <digestAuthentication enabled="false" />
        <windowsAuthentication enabled="false" authPersistNonNTLM="true">
          <providers>
            <add value="Negotiate" />
            <add value="NTLM" />
          </providers>
        </windowsAuthentication>
      </authentication>
      <authorization>
        <add accessType="Allow" users="*" />
      </authorization>
      <ipSecurity allowUnlisted="true" denyAction="Forbidden">
        <add ipAddress="192.0.2.0" subnetMask="255.255.255.0" allowed="false" />
      </ipSecurity>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
        <fileExtensions allowUnlisted="true" applyToWebDAV="true">
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".asa" allowed="false" />
          <add fileExtension=".asax" allowed="false" />
          <add fileExtension=".ascx" allowed="false" />
          <add fileExtension=".master" allowed="false" />
          <add fileExtension=".skin" allowed="false" />
          <add fileExtension=".browser" allowed="false" />
          <add fileExtension=".sitemap" allowed="false" />
          <add fileExtension=".config" allowed="false" />
          <add fileExtension=".cs" allowed="false" />
          <add fileExtension=".csproj" allowed="false" />
          <add fileExtension=".vb" allowed="false" />
          <add fileExtension=".vbproj" allowed="false" />
          <add fileExtension=".webinfo" allowed="false" />
          <add fileExtension=".licx" allowed="false" />
          <add fileExtension=".resx" allowed="false" />
          <add fileExtension=".resources" allowed="false" />
          <add fileExtension=".mdb" allowed="false" />
          <add fileExtension=".mdf" allowed="false" />
          <add fileExtension=".ldf" allowed="false" />
          <add fileExtension=".rules" allowed="false" />
        </fileExtensions>
        <verbs allowUnlisted="true" applyToWebDAV="true" />
        <hiddenSegments applyToWebDAV="true">
          <add segment="web.config" />
          <add segment="bin" />
          <add segment="App_code" />
          <add segment="App_GlobalResources" />
          <add segment="App_LocalResources" />
          <add segment="App_WebReferences" />
          <add segment="App_Data" />
          <add segment="App_Browsers" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <serverRuntime appConcurrentRequestLimit="10000" />
    <staticContent lockAttributes="isDocFooterFileName">
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <urlCompression />
  </system.webServer>
  <system.ftpServer>
    <providerDefinitions>
      <add name="IisManagerAuth" type="Microsoft.Web.FtpServer.Security.IisManagerAuthenticationProvider,Microsoft.Web.FtpServer,version=7.5.0.0,Culture=neutral,PublicKeyToken=31bf3856ad364e35" />
      <add name="AspNetAuth" type="Microsoft.Web.FtpServer.Security.AspNetFtpMembershipProvider,Microsoft.Web.FtpServer,version=7.5.0.0,Culture=neutral,PublicKeyToken=31bf3856ad364e35" />
    </providerDefinitions>
    <log>
      <centralLogFile directory="D:\Logs\FTP\Central" />
    </log>
    <firewallSupport lowDataChannelPort="50000" highDataChannelPort="50100" />
    <caching />
    <security>
      <ipSecurity />
      <requestFiltering>
        <hiddenSegments>
          <add segment="_vti_bin" />
        </hiddenSegments>
      </requestFiltering>
      <authorization />
    </security>
  </system.ftpServer>
  <location path="" overrideMode="Allow">
    <system.webServer>
      <handlers accessPolicy="Read, Script">
        <add name="ASPClassic" path="*.asp" verb="GET,HEAD,POST" modules="IsapiModule" scriptProcessor="%windir%\system32\inetsrv\asp.dll" resourceType="File" />
        <add name="PageHandlerFactory-Integrated-4.0" path="*.aspx" verb="GET,HEAD,POST,DEBUG" type="System.Web.UI.PageHandlerFactory" preCondition="integratedMode,runtimeVersionv4.0" />
        <add name="StaticFile" path="*" verb="*" modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule" resourceType="Either" requireAccess="Read" />
      </handlers>
      <modules>
        <add name="HttpLoggingModule" lockItem="true" />
        <add name="StaticCompressionModule" lockItem="true" />
        <add name="DefaultDocumentModule" lockItem="true" />
        <add name="StaticFileModule" lockItem="true" />
        <add name="RequestFilteringModule" lockItem="true" />
        <add name="RewriteModule" />
        <add name="ApplicationRequestRouting" />
        <add name="AspNetCoreModuleV2" />
      </modules>
    </system.webServer>
  </location>
  <location path="Commerce Storefront">
    <system.webServer>
      <defaultDocument enabled="true">
        <files>
          <add value="home.aspx" />
        </files>
      </defaultDocument>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
          <add name="X-Content-Type-Options" value="nosniff" />
        </customHeaders>
      </httpProtocol>
      <httpErrors errorMode="Custom" existingResponse="Replace">
        <remove statusCode="404" subStatusCode="-1" />
        <error statusCode="404" subStatusCode="-1" path="/errors/404.aspx" responseMode="ExecuteURL" />
      </httpErrors>
      <rewrite>
        <rewriteMaps>
          <rewriteMap name="LegacySkuMap" defaultValue="">
            <add key="1001" value="red-widget" />
            <add key="1002" value="blue-widget" />
            <add key="1003" value="green-gadget" />
          </rewriteMap>
        </rewriteMaps>
        <rules>
          <rule name="HTTP to HTTPS redirect" stopProcessing="true">
            <match url="(.*)" />
            <conditions>
              <add input="{HTTPS}" pattern="^OFF$" />
            </conditions>
            <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
          </rule>
          <rule name="Canonical host redirect" stopProcessing="true">
            <match url="(.*)" />
            <conditions logicalGrouping="MatchAll">
              <add input="{HTTP_HOST}" pattern="^shop\.contoso\.test$" negate="true" />
              <add input="{HTTP_HOST}" pattern="^(localhost|127\.0\.0\.1)(:\d+)?$" negate="true" />
            </conditions>
            <action type="Redirect" url="https://shop.contoso.test/{R:1}" redirectType="Permanent" />
          </rule>
          <rule name="Legacy old-shop to shop">
            <match url="^old-shop/(.*)" />
            <action type="Rewrite" url="/shop/{R:1}" />
          </rule>
          <rule name="Legacy category wildcard" patternSyntax="Wildcard" stopProcessing="true">
            <match url="old-category/*" />
            <action type="Redirect" url="/category/{R:1}" redirectType="Found" />
          </rule>
          <rule name="Legacy SKU redirect map" stopProcessing="true">
            <match url="^p/([0-9]+)$" />
            <conditions>
              <add input="{LegacySkuMap:{R:1}}" pattern="(.+)" />
            </conditions>
            <action type="Redirect" url="/product/{C:1}" redirectType="Found" />
          </rule>
          <rule name="Maintenance mode (disabled)" enabled="false" stopProcessing="true">
            <match url=".*" />
            <conditions>
              <add input="{REMOTE_ADDR}" pattern="^10\.20\." negate="true" />
            </conditions>
            <action type="CustomResponse" statusCode="503" subStatusCode="0" statusReason="Service Unavailable" statusDescription="Scheduled maintenance" />
          </rule>
        </rules>
        <outboundRules>
          <rule name="Rewrite http links to https" preCondition="ResponseIsHtml">
            <match filterByTags="A, Form, Img, Link, Script" pattern="^http://shop\.contoso\.test/(.*)" />
            <action type="Rewrite" value="https://shop.contoso.test/{R:1}" />
          </rule>
          <preConditions>
            <preCondition name="ResponseIsHtml">
              <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
            </preCondition>
          </preConditions>
        </outboundRules>
      </rewrite>
      <security>
        <dynamicIpSecurity denyAction="Forbidden">
          <denyByConcurrentRequests enabled="true" maxConcurrentRequests="20" />
          <denyByRequestRate enabled="true" maxRequests="50" requestIntervalInMilliseconds="2000" />
        </dynamicIpSecurity>
        <requestFiltering allowDoubleEscaping="false" allowHighBitCharacters="false" removeServerHeader="true">
          <fileExtensions allowUnlisted="true">
            <add fileExtension=".bak" allowed="false" />
            <add fileExtension=".sql" allowed="false" />
            <add fileExtension=".old" allowed="false" />
            <add fileExtension=".pdf" allowed="true" />
          </fileExtensions>
          <verbs allowUnlisted="true">
            <add verb="TRACE" allowed="false" />
            <add verb="DELETE" allowed="false" />
          </verbs>
          <hiddenSegments>
            <add segment="private" />
          </hiddenSegments>
          <denyUrlSequences>
            <add sequence=".." />
            <add sequence="/.git" />
          </denyUrlSequences>
          <filteringRules>
            <filteringRule name="Block SQL injection probes" scanUrl="false" scanQueryString="true">
              <appliesTo>
                <add fileExtension=".aspx" />
                <add fileExtension=".ashx" />
              </appliesTo>
              <denyStrings>
                <add string="xp_cmdshell" />
                <add string="union select" />
                <add string="--" />
              </denyStrings>
            </filteringRule>
            <filteringRule name="Block scanner user agents" scanUrl="false" scanQueryString="false">
              <scanHeaders>
                <add requestHeader="User-Agent" />
              </scanHeaders>
              <denyStrings>
                <add string="sqlmap" />
                <add string="nikto" />
              </denyStrings>
            </filteringRule>
          </filteringRules>
          <requestLimits maxAllowedContentLength="52428800" maxUrl="4096" maxQueryString="4096">
            <headerLimits>
              <add header="Content-type" sizeLimit="100" />
            </headerLimits>
          </requestLimits>
        </requestFiltering>
      </security>
      <tracing>
        <traceFailedRequests>
          <add path="*">
            <traceAreas>
              <add provider="ASP" verbosity="Verbose" />
              <add provider="ASPNET" areas="Infrastructure,Module,Page,AppServices" verbosity="Verbose" />
              <add provider="ISAPI Extension" verbosity="Verbose" />
              <add provider="WWW Server" areas="Authentication,Security,Filter,StaticFile,CGI,Compression,Cache,RequestNotifications,Module,Rewrite,FastCGI,WebSocket" verbosity="Verbose" />
            </traceAreas>
            <failureDefinitions statusCodes="500-599" timeTaken="00:00:30" />
          </add>
        </traceFailedRequests>
      </tracing>
    </system.webServer>
    <system.web>
      <httpRuntime maxRequestLength="51200" executionTimeout="600" requestPathInvalidCharacters="&lt;,&gt;,*,%,&amp;,:,\,?" />
      <sessionState mode="SQLServer" sqlConnectionString="Data Source=sessions01.corp.contoso.test;Integrated Security=SSPI" timeout="45" />
      <customErrors mode="RemoteOnly" defaultRedirect="~/error" />
      <authentication mode="Forms">
        <forms name=".ContosoShopAuth" loginUrl="~/account/login" timeout="30" requireSSL="true" slidingExpiration="true" />
      </authentication>
      <httpCookies httpOnlyCookies="true" requireSSL="true" />
    </system.web>
    <connectionStrings>
      <add name="CommerceDb" connectionString="Server=sql01.corp.contoso.test,1433;Database=CommerceDB;User Id=commerce_app;Password=P@ssw0rd-demo-only;Encrypt=True;Connection Timeout=15;" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
      <add key="Redis:ConnectionString" value="redis01.corp.contoso.test:6379,password=P@ssw0rd-demo-only,ssl=False,abortConnect=False" />
      <add key="Catalog:Environment" value="production" />
    </appSettings>
  </location>
  <location path="Commerce Storefront/admin">
    <system.webServer>
      <security>
        <authentication>
          <anonymousAuthentication enabled="false" />
          <windowsAuthentication enabled="true" useKernelMode="false" useAppPoolCredentials="true">
            <providers>
              <clear />
              <add value="Negotiate" />
            </providers>
          </windowsAuthentication>
        </authentication>
        <ipSecurity allowUnlisted="false">
          <add ipAddress="10.20.0.0" subnetMask="255.255.0.0" allowed="true" />
        </ipSecurity>
      </security>
    </system.webServer>
  </location>
  <location path="Commerce Storefront/static">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="Commerce Storefront/downloads">
    <system.webServer>
      <directoryBrowse enabled="true" showFlags="Date, Time, Size" />
    </system.webServer>
  </location>
  <location path="Commerce API">
    <system.webServer>
      <rewrite>
        <rules>
          <rule name="Require HTTPS" stopProcessing="true">
            <match url="(.*)" />
            <conditions logicalGrouping="MatchAll">
              <add input="{HTTPS}" pattern="^OFF$" />
              <add input="{SERVER_PORT}" pattern="^8081$" negate="true" />
            </conditions>
            <action type="CustomResponse" statusCode="403" subStatusCode="4" statusReason="Forbidden: SSL is required" statusDescription="This API requires HTTPS" />
          </rule>
          <rule name="Proxy v3 to commerce-api-farm" stopProcessing="true">
            <match url="^v3/(.*)" />
            <action type="Rewrite" url="http://commerce-api-farm/{R:1}" appendQueryString="true" logRewrittenUrl="true" />
          </rule>
        </rules>
      </rewrite>
      <security>
        <dynamicIpSecurity denyAction="AbortRequest" enableProxyMode="true">
          <denyByConcurrentRequests enabled="true" maxConcurrentRequests="100" />
          <denyByRequestRate enabled="true" maxRequests="300" requestIntervalInMilliseconds="1000" />
        </dynamicIpSecurity>
        <requestFiltering removeServerHeader="true">
          <verbs allowUnlisted="false">
            <add verb="GET" allowed="true" />
            <add verb="HEAD" allowed="true" />
            <add verb="POST" allowed="true" />
            <add verb="PUT" allowed="true" />
            <add verb="PATCH" allowed="true" />
            <add verb="DELETE" allowed="true" />
            <add verb="OPTIONS" allowed="true" />
          </verbs>
          <alwaysAllowedUrls>
            <add url="/health" />
          </alwaysAllowedUrls>
          <requestLimits maxAllowedContentLength="10485760" maxQueryString="8192" />
        </requestFiltering>
      </security>
      <serverRuntime uploadReadAheadSize="1048576" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="Cache-Control" value="no-store" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="Commerce API/v1">
    <connectionStrings>
      <add name="OrdersDb" connectionString="Server=tcp:contoso-prod.database.windows.net,1433;Initial Catalog=Orders;Persist Security Info=False;User ID=orders_api@contoso-prod;Password=P@ssw0rd-demo-only;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;" providerName="System.Data.SqlClient" />
    </connectionStrings>
  </location>
  <location path="Commerce API/v2">
    <system.webServer>
      <aspNetCore processPath="dotnet" arguments=".\Contoso.Catalog.Api.dll" hostingModel="outofprocess" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" requestTimeout="00:05:00" startupTimeLimit="180">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
    <connectionStrings>
      <add name="CatalogDb" connectionString="Host=pg01.corp.contoso.test;Port=5432;Database=catalog;Username=catalog_api;Password=P@ssw0rd-demo-only;SSL Mode=Require" providerName="Npgsql" />
    </connectionStrings>
  </location>
  <location path="Commerce API/internal">
    <system.webServer>
      <security>
        <authentication>
          <anonymousAuthentication enabled="false" />
          <windowsAuthentication enabled="true" />
        </authentication>
        <ipSecurity allowUnlisted="false" enableReverseDns="true" denyAction="NotFound">
          <add ipAddress="10.20.2.0" subnetMask="255.255.255.0" allowed="true" />
          <add ipAddress="10.20.1.40" allowed="true" />
          <add domainName="*.corp.contoso.test" allowed="true" />
        </ipSecurity>
      </security>
    </system.webServer>
  </location>
  <location path="Reports Legacy">
    <system.webServer>
      <rewrite>
        <rules>
          <rule name="Block scraper user agents" stopProcessing="true">
            <match url=".*" />
            <conditions>
              <add input="{HTTP_USER_AGENT}" pattern="(scrapy|python-requests|curl)" />
            </conditions>
            <action type="AbortRequest" />
          </rule>
        </rules>
      </rewrite>
      <security>
        <authentication>
          <anonymousAuthentication enabled="false" />
          <windowsAuthentication enabled="true">
            <providers>
              <clear />
              <add value="NTLM" />
            </providers>
          </windowsAuthentication>
          <basicAuthentication enabled="true" realm="Contoso Reports" defaultLogonDomain="CONTOSO" />
        </authentication>
        <ipSecurity denyAction="Forbidden">
          <add ipAddress="203.0.113.0" subnetMask="255.255.255.0" allowed="false" />
          <add ipAddress="198.51.100.77" allowed="false" />
        </ipSecurity>
      </security>
      <defaultDocument enabled="true">
        <files>
          <clear />
          <add value="Default.aspx" />
          <add value="reports.aspx" />
        </files>
      </defaultDocument>
      <handlers accessPolicy="Read, Script, Execute" />
      <asp enableParentPaths="true" scriptErrorSentToBrowser="true">
        <limits scriptTimeout="00:05:00" requestQueueMax="5000" />
        <session timeout="00:45:00" />
      </asp>
      <urlCompression doDynamicCompression="false" />
      <tracing>
        <traceFailedRequests>
          <add path="*.aspx">
            <traceAreas>
              <add provider="ASP" verbosity="Verbose" />
              <add provider="ASPNET" areas="Infrastructure,Module,Page,AppServices" verbosity="Verbose" />
              <add provider="WWW Server" areas="Authentication,Security,Filter,StaticFile,CGI,Compression,Cache,RequestNotifications,Module" verbosity="Verbose" />
            </traceAreas>
            <failureDefinitions statusCodes="500" timeTaken="00:00:10" verbosity="Error" />
          </add>
        </traceFailedRequests>
      </tracing>
    </system.webServer>
    <system.web>
      <compilation debug="true" batch="false" tempDirectory="D:\Temp\ASP.NET\Reports" />
      <httpRuntime executionTimeout="900" maxRequestLength="20480" />
    </system.web>
    <connectionStrings>
      <add name="ReportsDb" connectionString="Data Source=sql02.corp.contoso.test;Initial Catalog=ReportsDB;Integrated Security=SSPI;" providerName="System.Data.SqlClient" />
    </connectionStrings>
  </location>
  <location path="Reports Legacy/api">
    <system.web>
      <compilation targetFramework="4.8" optimizeCompilations="true" />
    </system.web>
  </location>
  <location path="Reports Legacy/admin">
    <system.web>
      <identity impersonate="true" />
      <authorization>
        <allow roles="CONTOSO\Report-Admins" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Reports Legacy/old">
    <system.webServer>
      <httpRedirect enabled="true" destination="https://reports.contoso.test/archive" exactDestination="false" childOnly="false" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="Partner FTP">
    <system.ftpServer>
      <security>
        <authorization>
          <add accessType="Allow" users="partner-a,partner-b" permissions="Read, Write" />
        </authorization>
        <ipSecurity allowUnlisted="false">
          <add ipAddress="198.51.100.0" subnetMask="255.255.255.0" allowed="true" />
          <add ipAddress="203.0.113.64" subnetMask="255.255.255.192" allowed="true" />
          <add ipAddress="10.20.1.0" subnetMask="255.255.255.0" allowed="true" />
        </ipSecurity>
        <requestFiltering>
          <fileExtensions allowUnlisted="true">
            <add fileExtension=".exe" allowed="false" />
            <add fileExtension=".bat" allowed="false" />
          </fileExtensions>
          <requestLimits maxAllowedContentLength="1073741824" />
        </requestFiltering>
        <authentication>
          <denyByFailure enabled="true" maxFailure="5" entryExpiration="00:10:00" />
        </authentication>
      </security>
    </system.ftpServer>
  </location>
  <location path="Public Downloads FTP">
    <system.ftpServer>
      <security>
        <authorization>
          <add accessType="Allow" users="?" permissions="Read" />
        </authorization>
        <requestFiltering>
          <fileExtensions allowUnlisted="false">
            <add fileExtension=".zip" allowed="true" />
            <add fileExtension=".msi" allowed="true" />
            <add fileExtension=".pdf" allowed="true" />
            <add fileExtension=".txt" allowed="true" />
          </fileExtensions>
          <denyUrlSequences>
            <add sequence=".." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.ftpServer>
  </location>
  <webFarms>
    <webFarm name="commerce-api-farm" enabled="true">
      <server address="10.20.2.11" enabled="true">
        <applicationRequestRouting weight="100" httpPort="80" httpsPort="443" />
      </server>
      <server address="10.20.2.12" enabled="true">
        <applicationRequestRouting weight="50" httpPort="80" httpsPort="443" />
      </server>
      <server address="10.20.2.13" enabled="false">
        <applicationRequestRouting weight="100" httpPort="80" httpsPort="443" />
      </server>
      <applicationRequestRouting>
        <protocol timeout="00:01:30" preserveHostHeader="true" reverseRewriteHostInResponseHeaders="false">
          <cache enabled="true" queryStringHandling="Accept" />
        </protocol>
        <affinity useCookie="true" cookieName="ARRAffinity" timeout="00:30:00" />
        <loadBalancing algorithm="RequestHash" hashServerVariable="REMOTE_ADDR" />
        <healthCheck url="http://commerce-api-farm/health" interval="00:00:15" timeout="00:00:05" responseMatch="OK" statusCodeMatch="200" minServers="2" />
      </applicationRequestRouting>
    </webFarm>
    <webFarm name="legacy-reports-farm" enabled="false">
      <server address="10.20.3.21" enabled="true">
        <applicationRequestRouting weight="100" httpPort="8088" httpsPort="443" />
      </server>
      <applicationRequestRouting>
        <healthCheck url="http://legacy-reports-farm/ping.aspx" interval="00:01:00" timeout="00:00:10" />
      </applicationRequestRouting>
    </webFarm>
    <applicationRequestRouting>
      <hostAffinityProviderList>
        <add name="Microsoft.Web.Arr.HostNameRoundRobin" />
        <add name="Microsoft.Web.Arr.HostNameMemory" />
      </hostAffinityProviderList>
    </applicationRequestRouting>
  </webFarms>
</configuration>
