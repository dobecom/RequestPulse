<?xml version="1.0" encoding="utf-8"?>
<!-- Synthetic sample: not a real application. Contoso Retail is fictional; every host, account and secret is fake. -->
<configuration>
  <appSettings>
    <add key="Environment" value="production" />
    <add key="Reports:ExportPath" value="E:\Exports\Reports" />
    <add key="Reports:MaxRows" value="500000" />
    <add key="Smtp:Host" value="smtp01.corp.contoso.test" />
    <add key="Smtp:Password" value="P@ssw0rd-demo-only" />
    <add key="ApiKey" value="demo-only-0000-1111-2222-3333" />
  </appSettings>
  <connectionStrings>
    <add name="ReportsDb" connectionString="Data Source=sql02.corp.contoso.test;Initial Catalog=ReportsDB;Integrated Security=SSPI;" providerName="System.Data.SqlClient" />
    <add name="ReportsReadOnly" connectionString="Server=sql02.corp.contoso.test,1433;Database=ReportsDB;User Id=reports_ro;Password=P@ssw0rd-demo-only;Connection Timeout=60;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" executionTimeout="1800" maxRequestLength="102400" />
    <sessionState mode="InProc" cookieless="UseUri" timeout="120" />
    <customErrors mode="Off" />
    <httpCookies httpOnlyCookies="false" requireSSL="false" />
    <identity impersonate="true" />
    <trace enabled="true" localOnly="false" requestLimit="100" />
  </system.web>
  <system.webServer>
    <directoryBrowse enabled="true" />
    <security>
      <authentication>
        <windowsAuthentication enabled="true" useAppPoolCredentials="true" />
      </authentication>
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="1073741824" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="Legacy report URL" stopProcessing="true">
          <match url="^reports/old/(.*)" />
          <action type="Redirect" url="/reports/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Hide default page">
          <match url="^default\.aspx$" />
          <action type="Rewrite" url="/reports/index.aspx" />
        </rule>
        <rule name="Trailing slash (disabled)" enabled="false">
          <match url="(.*[^/])$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Redirect" url="{R:1}/" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <sampleVendor telemetryToken="synthetic-secret-for-preview" compatibilityMode="legacy" />
</configuration>
