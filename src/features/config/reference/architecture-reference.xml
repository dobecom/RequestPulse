      <item fileExtension=".asa" allowed="false" />
      <item fileExtension=".asax" allowed="false" />
      <item fileExtension=".ascx" allowed="false" />
      <item fileExtension=".master" allowed="false" />
      <item fileExtension=".skin" allowed="false" />
      <item fileExtension=".browser" allowed="false" />
      <item fileExtension=".sitemap" allowed="false" />
      <item fileExtension=".config" allowed="false" />
      <item fileExtension=".cs" allowed="false" />
      <item fileExtension=".csproj" allowed="false" />
      <item fileExtension=".vb" allowed="false" />
      <item fileExtension=".vbproj" allowed="false" />
      <item fileExtension=".webinfo" allowed="false" />
      <item fileExtension=".licx" allowed="false" />
      <item fileExtension=".resx" allowed="false" />
      <item fileExtension=".resources" allowed="false" />
      <item fileExtension=".mdb" allowed="false" />
      <item fileExtension=".vjsproj" allowed="false" />
      <item fileExtension=".java" allowed="false" />
      <item fileExtension=".jsl" allowed="false" />
      <item fileExtension=".ldb" allowed="false" />
      <item fileExtension=".dsdgm" allowed="false" />
      <item fileExtension=".ssdgm" allowed="false" />
      <item fileExtension=".lsad" allowed="false" />
      <item fileExtension=".ssmap" allowed="false" />
      <item fileExtension=".cd" allowed="false" />
      <item fileExtension=".dsprototype" allowed="false" />
      <item fileExtension=".lsaprototype" allowed="false" />
      <item fileExtension=".sdm" allowed="false" />
      <item fileExtension=".sdmDocument" allowed="false" />
      <item fileExtension=".mdf" allowed="false" />
      <item fileExtension=".ldf" allowed="false" />
      <item fileExtension=".ad" allowed="false" />
      <item fileExtension=".dd" allowed="false" />
      <item fileExtension=".ldd" allowed="false" />
      <item fileExtension=".sd" allowed="false" />
      <item fileExtension=".adprototype" allowed="false" />
      <item fileExtension=".lddprototype" allowed="false" />
      <item fileExtension=".exclude" allowed="false" />
      <item fileExtension=".refresh" allowed="false" />
      <item fileExtension=".compiled" allowed="false" />
      <item fileExtension=".msgx" allowed="false" />
      <item fileExtension=".vsdisco" allowed="false" />
      <item fileExtension=".rules" allowed="false" />
    </collection>
    <collection path="system.webServer/security/requestFiltering/hiddenSegments">
      <item segment="web.config" />
      <item segment="bin" />
      <item segment="App_code" />
      <item segment="App_GlobalResources" />
      <item segment="App_LocalResources" />
      <item segment="App_WebReferences" />
      <item segment="App_Data" />
      <item segment="App_Browsers" />
    </collection>
    <collection path="system.webServer/defaultDocument/files">
      <item value="Default.htm" />
      <item value="Default.asp" />
      <item value="index.htm" />
      <item value="index.html" />
      <item value="iisstart.htm" />
      <item value="default.aspx" />
    </collection>
    <collection path="system.webServer/httpErrors">
      <item statusCode="401" path="401.htm" />
      <item statusCode="403" path="403.htm" />
      <item statusCode="404" path="404.htm" />
      <item statusCode="405" path="405.htm" />
      <item statusCode="406" path="406.htm" />
      <item statusCode="412" path="412.htm" />
      <item statusCode="431" path="431.htm" />
      <item statusCode="500" path="500.htm" />
      <item statusCode="501" path="501.htm" />
      <item statusCode="502" path="502.htm" />
    </collection>
    <collection path="system.webServer/httpProtocol/customHeaders">
      <item name="X-Powered-By" value="ASP.NET" />
    </collection>
    <collection path="system.webServer/security/authorization">
      <item accessType="Allow" users="*" />
    </collection>
    <collection path="system.webServer/security/authentication/windowsAuthentication/providers">
      <item value="Negotiate" />
      <item value="NTLM" />
    </collection>
    <collection path="system.ftpServer/security/requestFiltering/hiddenSegments">
      <item segment="_vti_bin" />
    </collection>
  </defaultCollections>

  <!-- Collections that stock IIS fills at server scope; entries there are installation baseline, not tuning. -->
  <serverBaselineCollections>
    <collection path="system.webServer/security/isapiCgiRestriction" />
    <collection path="system.webServer/security/applicationDependencies" />
    <collection path="system.webServer/tracing/traceProviderDefinitions" />
    <collection path="system.ftpServer/providerDefinitions" />
    <collection path="system.webServer/management/trustedProviders" />
    <collection path="system.webServer/httpProtocol/redirectHeaders" />
  </serverBaselineCollections>

  <!-- Defaults that differ from the schema value in a stock IIS applicationHost.config. -->
  <valueDefaults>
    <default path="system.applicationHost/applicationPools/add" name="managedRuntimeVersion" value="v4.0" />
    <default path="system.webServer/security/authentication/windowsAuthentication" name="authPersistNonNTLM" value="true" />
  </valueDefaults>

  <!-- Connection-string engine detection; the first matching engine wins. -->
  <databaseEngines>
    <engine id="azure-sql" label="Azure SQL" host="\.database\.(windows\.net|chinacloudapi\.cn|usgovcloudapi\.net|cloudapi\.de)$|\.sql\.azuresynapse\.net$" />
    <engine id="cosmos" label="Cosmos DB" keys="accountendpoint" />
    <engine id="oracle" label="Oracle" provider="oracle|oraclient|odp\.net|oledb\.oracle" keys="\(description\s*=" />
    <engine id="mysql" label="MySQL / MariaDB" provider="mysql|mariadb" keys="\buid\s*=.*\bpwd\s*=|\bport\s*=\s*3306" />
    <engine id="postgres" label="PostgreSQL" provider="npgsql|postgres" keys="\bhost\s*=|\bport\s*=\s*5432" />
    <engine id="mssql" label="SQL Server" provider="sqlclient|sqlserver|sqlncli|sqloledb|entityclient" keys="initial catalog|integrated security|trusted_connection|multipleactiveresultsets" />
    <engine id="file" label="Local file database" provider="sqlite|sqlserverce|jet\.oledb|ace\.oledb" keys="\.(sdf|mdb|accdb|db|sqlite)\b|attachdbfilename|\|datadirectory\|" />
    <engine id="state" label="ASP.NET State Server" />
    <engine id="other" label="Database" />
  </databaseEngines>
</architectureReference>
