<?xml version="1.0" encoding="utf-8"?>
<architectureReference schemaVersion="1" source="Microsoft IIS configuration reference (Microsoft Learn) and a default IIS 10 applicationHost.config" documentation="https://learn.microsoft.com/iis/configuration/">
  <!--
    Layers drawn in the architecture diagram, grouped by scope.
    scope="global": server-wide rules in applicationHost.config, evaluated first for every request.
    scope="inherited": server-level values that every site inherits unless the site overrides them.
    order is display order inside a group, not execution order.
  -->
  <layers>
    <layer id="global-rules" label="Global URL Rewrite" order="1" scope="global" icon="layer-url-rewrite" learn="https://learn.microsoft.com/iis/extensions/url-rewrite-module/url-rewrite-module-configuration-reference">URL Rewrite global rules (IIS Home → URL Rewrite). They are defined only in applicationHost.config, apply to every request and cannot be overridden by a web.config. They are evaluated first, at PreBeginRequest, before site and application rules (BeginRequest). A rule that rewrites to a server farm or proxy host is an ARR routing rule and is listed under ARR routing, not here.</layer>
    <layer id="arr-routing" label="ARR routing" order="2" scope="global" icon="layer-arr-routing" learn="https://learn.microsoft.com/iis/extensions/planning-for-arr/using-the-application-request-routing-module">Application Request Routing is an HTTP-level reverse proxy and load balancer. Its routing rules are URL Rewrite rules that rewrite to a server farm or proxy host. Creating a farm in IIS Manager offers to add a global rule (ARR_&lt;farm&gt;_loadbalance), but a rule in a site's web.config also works and is then site-level. When a rule changes the URL, ARR sets its handler at MapRequestHandler and proxies at ExecuteRequestHandler instead of running the site's own content handler. Enable proxy is a server-level setting (system.webServer/proxy).</layer>
    <layer id="ip-restrictions" label="IP restrictions" order="3" scope="inherited" icon="layer-ip-restrictions" learn="https://learn.microsoft.com/iis/configuration/system.webserver/security/ipsecurity/">Allows or denies client IP addresses and domains, including dynamic request-rate blocking, before any content is served.</layer>
    <layer id="request-filtering" label="Request filtering" order="4" scope="inherited" icon="layer-request-filtering" learn="https://learn.microsoft.com/iis/configuration/system.webserver/security/requestfiltering/">Rejects requests by file extension, verb, URL, header, query string, size and custom rules.</layer>
    <layer id="redirect" label="HTTP redirect" order="5" scope="inherited" icon="layer-redirect" learn="https://learn.microsoft.com/iis/configuration/system.webserver/httpredirect/">Sends the client to another URL before the request reaches the site content.</layer>
    <layer id="url-rewrite" label="URL Rewrite" order="6" scope="inherited" icon="layer-url-rewrite" learn="https://learn.microsoft.com/iis/extensions/url-rewrite-module/url-rewrite-module-configuration-reference">Inbound and outbound rules and rewrite maps set at server level. Sites inherit them and can add their own rules in web.config, which are evaluated at BeginRequest, after the global rules. Global rules and ARR routing rules are listed in the global group.</layer>
    <layer id="authentication" label="Authentication" order="7" scope="inherited" icon="layer-authentication" learn="https://learn.microsoft.com/iis/configuration/system.webserver/security/authentication/">Identifies the caller with Anonymous, Windows, Basic, Digest, certificate or ASP.NET Forms authentication.</layer>
  </layers>

  <!-- Maps configuration paths to the categories and groups shown in the detail balloon. -->
  <groups>
    <group id="pool-general" category="pool" label="General" path="system.applicationHost/applicationPools/add" />
    <group id="pool-process-model" category="pool" label="Process model" path="system.applicationHost/applicationPools/add/processModel" />
    <group id="pool-recycling" category="pool" label="Recycling" path="system.applicationHost/applicationPools/add/recycling" />
    <group id="pool-failure" category="pool" label="Rapid-fail protection" path="system.applicationHost/applicationPools/add/failure" />
    <group id="pool-cpu" category="pool" label="CPU limits" path="system.applicationHost/applicationPools/add/cpu" />

    <group id="aspnet-compilation" category="aspnet" label="Compilation" path="system.web/compilation" />
    <group id="aspnet-runtime" category="aspnet" label="HTTP runtime" path="system.web/httpRuntime" />
    <group id="aspnet-session" category="aspnet" label="Session state" path="system.web/sessionState" />
    <group id="aspnet-auth" category="aspnet" label="Authentication and authorization" path="system.web/authentication system.web/authorization system.web/membership system.web/roleManager" />
    <group id="aspnet-errors" category="aspnet" label="Custom errors" path="system.web/customErrors" />
    <group id="aspnet-identity" category="aspnet" label="Identity and trust" path="system.web/identity system.web/trust" />
    <group id="aspnet-diagnostics" category="aspnet" label="Tracing and diagnostics" path="system.web/trace system.web/healthMonitoring" />
    <group id="aspnet-cookies" category="aspnet" label="Cookies and keys" path="system.web/httpCookies system.web/machineKey" />
    <group id="aspnet-connections" category="aspnet" label="Connection strings" path="connectionStrings" />
    <group id="aspnet-appsettings" category="aspnet" label="Application settings" path="appSettings" />
    <group id="aspnet-other" category="aspnet" label="Other ASP.NET settings" path="system.web system.net system.data system.diagnostics system.transactions system.codedom" />

    <group id="ip-restrictions" category="iis" label="IP address and domain restrictions" layer="ip-restrictions" sub="ip" path="system.webServer/security/ipSecurity" />
    <group id="dynamic-ip" category="iis" label="Dynamic IP restrictions" layer="ip-restrictions" sub="dynamic" path="system.webServer/security/dynamicIpSecurity" />

    <group id="request-filtering" category="iis" label="Request filtering" layer="request-filtering" sub="general" path="system.webServer/security/requestFiltering" />
    <group id="rf-extensions" category="iis" parent="request-filtering" label="File name extensions" layer="request-filtering" sub="extensions" path="system.webServer/security/requestFiltering/fileExtensions" />
    <group id="rf-rules" category="iis" parent="request-filtering" label="Rules" layer="request-filtering" sub="rules" path="system.webServer/security/requestFiltering/filteringRules" />
    <group id="rf-verbs" category="iis" parent="request-filtering" label="HTTP verbs" layer="request-filtering" sub="verbs" path="system.webServer/security/requestFiltering/verbs" />
    <group id="rf-url" category="iis" parent="request-filtering" label="URL" layer="request-filtering" sub="url" path="system.webServer/security/requestFiltering/hiddenSegments system.webServer/security/requestFiltering/denyUrlSequences system.webServer/security/requestFiltering/alwaysAllowedUrls" />
    <group id="rf-url-limit" category="iis" parent="request-filtering" label="URL" layer="request-filtering" sub="url" path="system.webServer/security/requestFiltering/requestLimits" attributes="maxUrl" />
    <group id="rf-headers" category="iis" parent="request-filtering" label="Headers" layer="request-filtering" sub="headers" path="system.webServer/security/requestFiltering/requestLimits/headerLimits" />
    <group id="rf-query" category="iis" parent="request-filtering" label="Query strings" layer="request-filtering" sub="query" path="system.webServer/security/requestFiltering/denyQueryStringSequences system.webServer/security/requestFiltering/alwaysAllowedQueryStrings" />
    <group id="rf-query-limit" category="iis" parent="request-filtering" label="Query strings" layer="request-filtering" sub="query" path="system.webServer/security/requestFiltering/requestLimits" attributes="maxQueryString" />

    <group id="http-redirect" category="iis" label="HTTP redirect" layer="redirect" path="system.webServer/httpRedirect" />

    <group id="url-rewrite" category="iis" label="URL Rewrite" layer="url-rewrite" sub="general" path="system.webServer/rewrite" />
    <group id="rewrite-global" category="iis" parent="url-rewrite" label="Global rules" layer="global-rules" sub="global" path="system.webServer/rewrite/globalRules" />
    <group id="rewrite-rules" category="iis" parent="url-rewrite" label="Inbound rules" layer="url-rewrite" sub="inbound" path="system.webServer/rewrite/rules" />
    <group id="rewrite-outbound" category="iis" parent="url-rewrite" label="Outbound rules" layer="url-rewrite" sub="outbound" path="system.webServer/rewrite/outboundRules" />
    <group id="rewrite-maps" category="iis" parent="url-rewrite" label="Rewrite maps" layer="url-rewrite" sub="maps" path="system.webServer/rewrite/rewriteMaps" />

    <group id="authentication" category="iis" label="Authentication" layer="authentication" sub="methods" path="system.webServer/security/authentication" />
    <group id="authorization" category="iis" label="Authorization rules" layer="authentication" sub="authorization" path="system.webServer/security/authorization" />
    <group id="ssl-settings" category="iis" label="SSL settings" layer="authentication" sub="ssl" path="system.webServer/security/access" />

    <group id="arr-proxy" category="iis" label="ARR proxy" layer="arr-routing" sub="proxy" path="system.webServer/proxy" />
    <group id="arr-farm" category="iis" label="ARR server farm" layer="arr-routing" sub="farm" path="webFarms/webFarm" />
    <group id="arr-global" category="iis" label="ARR global settings" layer="arr-routing" sub="proxy" path="webFarms" />

    <group id="default-document" category="iis" label="Default document" path="system.webServer/defaultDocument" />
    <group id="http-protocol" category="iis" label="HTTP response headers" path="system.webServer/httpProtocol" />
    <group id="http-errors" category="iis" label="Error pages" path="system.webServer/httpErrors" />
    <group id="static-content" category="iis" label="Static content and caching" path="system.webServer/staticContent" />
    <group id="compression" category="iis" label="Compression" path="system.webServer/urlCompression" />
    <group id="directory-browse" category="iis" label="Directory browsing" path="system.webServer/directoryBrowse" />
    <group id="logging" category="iis" label="Logging" path="system.applicationHost/sites/site/logFile system.webServer/httpLogging" />
    <group id="tracing" category="iis" label="Failed request tracing" path="system.applicationHost/sites/site/traceFailedRequestsLogging system.webServer/tracing" />
    <group id="runtime" category="iis" label="Server runtime and ASP" path="system.webServer/serverRuntime system.webServer/asp" />
    <group id="site-limits" category="iis" label="Site limits" path="system.applicationHost/sites/site/limits" />
    <group id="site" category="iis" label="Site" path="system.applicationHost/sites/site" />
    <group id="site-hsts" category="iis" label="HSTS" path="system.applicationHost/sites/site/hsts" />
    <group id="application" category="iis" label="Application" path="system.applicationHost/sites/site/application" />
    <group id="virtual-directory" category="iis" label="Virtual directory" path="system.applicationHost/sites/site/application/virtualDirectory" />
    <group id="ftp" category="iis" label="FTP server" path="system.applicationHost/sites/site/ftpServer system.ftpServer" />
    <group id="ftp-ssl" category="iis" parent="ftp" label="FTP SSL" path="system.applicationHost/sites/site/ftpServer/security/ssl" />
    <group id="ftp-auth" category="iis" parent="ftp" label="FTP authentication" path="system.applicationHost/sites/site/ftpServer/security/authentication" />
    <group id="ftp-authz" category="iis" parent="ftp" label="FTP authorization" path="system.ftpServer/security/authorization" />
    <group id="ftp-isolation" category="iis" parent="ftp" label="FTP user isolation" path="system.applicationHost/sites/site/ftpServer/userIsolation" />
    <group id="ftp-firewall" category="iis" parent="ftp" label="FTP firewall support" path="system.ftpServer/firewallSupport" />
    <group id="iis-other" category="iis" label="Other IIS settings" path="system.webServer system.applicationHost" />
  </groups>

  <!-- Built-in IIS collection entries. Entries that match these are not reported as changes. -->
  <defaultCollections>
